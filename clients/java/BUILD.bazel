load("@rules_java//java:defs.bzl", "java_library", "java_test")

package(default_visibility = ["//visibility:public"])

java_library(
    name = "modenv",
    srcs = [
        "src/main/java/com/retailcortex/modenv/EnvManager.java",
        "src/main/java/com/retailcortex/modenv/Modenv.java",
    ],
    deps = [
        "@maven//:org_tomlj_tomlj",
    ],
)

java_test(
    name = "ModenvTest",
    srcs = ["src/test/java/com/retailcortex/modenv/ModenvTest.java"],
    args = ["execute", "--select-class=com.retailcortex.modenv.ModenvTest"],
    data = ["//test:test_configs"],
    main_class = "org.junit.platform.console.ConsoleLauncher",
    use_testrunner = False,
    deps = [
        ":modenv",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_console",
        "@maven//:org_junit_platform_junit_platform_launcher",
    ],
)

java_test(
    name = "IntegrationTest",
    srcs = ["src/test/java/com/retailcortex/modenv/IntegrationTest.java"],
    args = ["execute", "--select-class=com.retailcortex.modenv.IntegrationTest"],
    data = ["//test:test_configs"],
    main_class = "org.junit.platform.console.ConsoleLauncher",
    use_testrunner = False,
    deps = [
        ":modenv",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_console",
        "@maven//:org_junit_platform_junit_platform_launcher",
    ],
)

