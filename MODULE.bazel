module(
    name = "modenv",
    version = "0.0.1",
)

# Go
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.51.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//clients/go:go.mod")

use_repo(
    go_deps,
    "com_github_burntsushi_toml",
    "com_github_stretchr_testify",
)

# Python
bazel_dep(name = "rules_python", version = "1.9.2")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.13", is_default = True)

# Java
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "6.8")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    known_contributing_modules = ["modenv", "protobuf"],
    artifacts = [
        "org.tomlj:tomlj:1.1.1",
        "org.junit.jupiter:junit-jupiter-api:5.10.2",
        "org.junit.jupiter:junit-jupiter-engine:5.10.2",
        "org.junit.jupiter:junit-jupiter-params:5.10.2",
        "org.junit.platform:junit-platform-console:1.10.2",
        "org.junit.platform:junit-platform-launcher:1.10.2",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")

# Node.js & pnpm
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "aspect_rules_js", version = "3.4.0")
bazel_dep(name = "aspect_rules_ts", version = "3.10.0")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "20.18.0")
use_repo(node, "nodejs_toolchains")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
pnpm.npm_translate_lock(
    name = "pnpm",
    pnpm_lock = "//clients/typescript:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(pnpm, "pnpm")

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
rules_ts_ext.deps()
use_repo(rules_ts_ext, "npm_typescript")

# Shell
bazel_dep(name = "rules_shell", version = "0.6.1")

# Hugo
bazel_dep(name = "rules_hugo", version = "0.3.0")
git_override(
    module_name = "rules_hugo",
    remote = "https://github.com/retail-cortex/rules-hugo.git",
    commit = "4710c8855aee048aa98f6b6be57723ae83084fcc",
)

hugo_deps = use_extension("@rules_hugo//hugo:extensions.bzl", "hugo_deps")
use_repo(hugo_deps, "hugo", "hugo_theme_book")
