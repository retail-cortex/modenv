load("@rules_hugo//hugo:rules.bzl", "hugo_serve", "hugo_site", "hugo_theme")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

hugo_theme(
    name = "book",
    srcs = [
        "@hugo_theme_book//:files",
    ],
)

hugo_site(
    name = "site",
    config = "config.yaml",
    content = glob(["content/**"]),
    layouts = glob(
        ["layouts/**"],
        allow_empty = True,
    ),
    static = glob(
        ["static/**"],
        allow_empty = True,
    ),
    theme = ":book",
    verbose = True,
)

hugo_serve(
    name = "serve",
    dep = [":site"],
    quiet = False,
    verbose = True,
)

sh_test(
    name = "site_test",
    srcs = ["site_test.sh"],
    data = [":site"],
)
